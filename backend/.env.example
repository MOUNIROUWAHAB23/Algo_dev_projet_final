# ============================================
# Backend - Variables d'environnement
# ============================================

# Server
NODE_ENV=production
PORT=3001

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/tourisme

# JWT
JWT_SECRET=change_me_in_production_with_secure_random_string_12345
JWT_EXPIRES_IN=8h

# URLs
FRONTEND_URL=http://frontend
AIRFLOW_URL=http://airflow-webserver:8080

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Data.gouv.fr (optionnel - pour imports directs)
DATAGOV_API_KEY=
