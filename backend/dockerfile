# ============================================
# Dockerfile - Backend Node.js API
# ============================================

# Build stage
FROM node:20-alpine 

WORKDIR /

# Copy dependencies
COPY package*.json ./
RUN npm i

# Copy source and build
COPY /. .
# RUN npm run dev

# Production stage
# FROM node:20-alpine

# WORKDIR /app

# Install production dependencies only
# COPY package*.json ./
# RUN npm ci --only=production

# Copy built files from builder
# COPY --from=builder /app/dist ./dist

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3400/api/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

EXPOSE 3400

# CMD ["ls"]
CMD ["npx", "nodemon", "index.js"]